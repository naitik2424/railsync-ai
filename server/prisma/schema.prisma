// RailSync AI - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id                                String   @id
  title                             String
  description                       String   @default("")
  department                        String
  section                           String
  maintenanceType                   String
  plannedDurationHours              Float
  actualDurationHours               Float?
  priority                          String   @default("Medium")
  status                            String   @default("Pending")
  crewType                          String
  crewSize                          Int      @default(4)
  equipment                         String[]
  powerBlockRequired                Boolean  @default(false)
  speedRestrictionKmh               Int?
  crewAvailabilityRatio             Float    @default(1.0)
  equipmentAvailable                Boolean  @default(true)
  dependencies                      String[]
  compatibleWithSimultaneousTypes   String[]
  plannedStartOffsetHours           Float    @default(0.0)
  scheduledStartHour                Float?
  scheduledEndHour                  Float?
  scheduledWindowId                 String?
  predictedDelayProbability         Float?
  riskLevel                         String?  @default("Low")
  delayFactors                      String[]
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@map("tasks")
}

model DisruptionScenario {
  id                     String   @id
  title                  String
  description            String
  disruptionType         String
  targetEquipment        String?
  targetCrewType         String?
  targetTaskId           String?
  targetSection          String?
  durationMultiplier     Float?   @default(1.5)
  crewShortagePercentage Float?   @default(0.5)
  createdAt              DateTime @default(now())

  @@map("disruption_scenarios")
}
